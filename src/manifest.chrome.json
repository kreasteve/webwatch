{
  "manifest_version": 3,
  "name": "Datenspur",
  "version": "0.3.2",
  "homepage_url": "https://github.com/kreasteve/datenspur",
  "description": "Zeigt, was eine Website an ihren Betreiber und an Dritte schickt — Klartext für Laien, Rohdaten für Profis. Alles bleibt lokal.",
  "permissions": [
    "webRequest",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/sw.js"
  },
  "action": {
    "default_title": "Datenspur — was schickt diese Seite wohin?",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
